@startuml use-case-diagram
!pragma layout smetana
title Multi-Client Chat — Use Cases
skinparam shadowing false
skinparam defaultFontName Segoe UI
skinparam usecase {
  BackgroundColor #EEF2FF
  BorderColor #4F46E5
}
left to right direction

actor "Chat user" as User
actor "Read-only guest" as Guest
actor "Server operator" as Operator

rectangle "TCPClient" {
  usecase "Join with a username" as UC1
  usecase "Join without a username\n(READ-ONLY MODE)" as UC2
  usecase "Send a message\n(SEND button or Enter)" as UC3
  usecase "Read the group conversation" as UC4
  usecase "List active users\n(allUsers)" as UC5
  usecase "Leave the chat\n(end, bye or LEAVE)" as UC6
}

rectangle "TCPServer" {
  usecase "Start / stop the server" as UC7
  usecase "Watch connected users\n(colored live list)" as UC8
  usecase "Watch the activity log" as UC9
}

User --> UC1
User --> UC3
User --> UC4
User --> UC5
User --> UC6
Guest --> UC2
Guest --> UC4
Guest --> UC5
Guest --> UC6
Operator --> UC7
Operator --> UC8
Operator --> UC9
@enduml
