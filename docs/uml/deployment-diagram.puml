@startuml deployment-diagram
!pragma layout smetana
title Multi-Client Chat — Deployment Diagram
skinparam shadowing false
skinparam defaultFontName Segoe UI
skinparam node {
  BackgroundColor #EEF2FF
  BorderColor #4F46E5
}
skinparam artifact {
  BackgroundColor #FFFFFF
  BorderColor #334155
}
skinparam ArrowColor #334155

node "Server machine\n<<device>>" as serverNode {
  node "JVM 21+\n<<execution environment>>" as serverJvm {
    artifact "TCPServer.jar" as serverJar
    artifact "server.properties\nserver.ip=0.0.0.0\nserver.port=3000" as serverProps
    component "ServerSocket :3000\n(1 virtual thread per client)" as serverSocket
  }
}

node "Client machine A\n<<device>>" as clientA {
  node "JVM 21+ " as jvmA {
    artifact "TCPClient.jar\nargs: <serverIP> 3000" as jarA
  }
}

node "Client machine B\n<<device>>" as clientB {
  node "JVM 21+  " as jvmB {
    artifact "TCPClient.jar\nargs: <serverIP> 3000" as jarB
  }
}

node "Client machine N\n<<device>>" as clientN {
  node "JVM 21+   " as jvmN {
    artifact "TCPClient.jar\n(no args: client.properties)" as jarN
  }
}

serverJar ..> serverProps : reads at startup
serverJar -- serverSocket

jarA -- serverSocket : TCP/IP\nLAN or localhost\nUTF-8 line protocol
jarB -- serverSocket : TCP/IP
jarN -- serverSocket : TCP/IP
@enduml
