@startuml sequence-diagram
title Multi-Client Chat — Message Flow\n<size:11>packet fields are tab-separated on the wire (shown here as " | ")</size>
skinparam shadowing false
skinparam defaultFontName Segoe UI
skinparam sequence {
  ParticipantBackgroundColor #EEF2FF
  ParticipantBorderColor #4F46E5
  LifeLineBorderColor #94A3B8
  ArrowColor #334155
}
autonumber

actor Alice
participant "ChatView\n(Alice)" as AView
participant "ChatClient\n(Alice)" as AClient
participant "ClientHandler\n(virtual thread)" as AHandler
participant "ChatServer" as Server
participant "ClientHandler\n(Bob)" as BHandler
participant "ChatClient\n(Bob)" as BClient
actor Bob

== Join ==
Alice -> AView : enter "alice", Join
AView -> AClient : connect("alice")
AClient -> AHandler : HELLO |alice
AHandler -> Server : join(handler, "alice")
Server -> Server : validate + register
Server --> AHandler : WELCOME |alice |false
AHandler --> AClient
Server -> BHandler : INFO |14:05 |alice joined the chat
BHandler --> BClient
BClient --> Bob : "alice joined the chat"

== Chat message ==
Alice -> AView : type "Hello!" + Enter
AView -> AClient : send("Hello!")
AClient -> AHandler : MESSAGE |Hello!
AHandler -> Server : handleMessage(handler, "Hello!")
Server -> Server : stamp sender + time
par broadcast to everyone
  Server -> AHandler : CHAT |14:06 |alice |Hello!
  AHandler --> AClient
  AClient --> AView : own bubble (right)
else
  Server -> BHandler : CHAT |14:06 |alice |Hello!
  BHandler --> BClient
  BClient --> Bob : alice's bubble (left)
end

== allUsers (reply to the requester only) ==
Alice -> AClient : send("allUsers")
AClient -> AHandler : MESSAGE |allUsers
AHandler -> Server : handleMessage
Server --> AHandler : USERS |alice |bob
AHandler --> AClient
AClient --> AView : "Active users (2)"

== Leave ==
Alice -> AClient : send("bye") / LEAVE button
AClient -> AHandler : BYE
AClient -> AClient : close socket
AHandler -> Server : clientFinished(handler)
Server -> Server : unregister
Server -> BHandler : INFO |14:08 |alice left the chat
BHandler --> BClient
BClient --> Bob : "alice left the chat"
@enduml
